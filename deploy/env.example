# Names of the variables the server's /data/apps/cashier/.env needs (mode 600). Values are made up.
# Generate secrets with: openssl rand -hex 24
TZ=Asia/Singapore
APP_URL=https://cashier.xiangyu.pro
AUTH_SECRET=replace-with-a-long-random-value
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=
AI_MODEL=
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=moli-cashier
OIDC_CLIENT_SECRET=replace-me

# Database and object store inside the same compose project.
DATABASE_URL=postgresql://cashier:replace-with-the-postgres-password@postgres:5432/cashier?sslmode=disable
S3_ENDPOINT=http://s3:7070
S3_REGION=auto
S3_BUCKET=cashier
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# The same values again, under the names the containers read (compose cannot rename them here).
POSTGRES_PASSWORD=replace-with-the-postgres-password
ROOT_ACCESS_KEY_ID=replace-me
ROOT_SECRET_ACCESS_KEY=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
