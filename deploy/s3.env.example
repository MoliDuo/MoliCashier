# s3.env next to docker-compose.yml on the server (mode 600): the object store and the bucket
# bootstrap read it. All four values must match S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY in .env:
# the gateway calls them ROOT_*, the AWS CLI calls them AWS_*.
ROOT_ACCESS_KEY_ID=replace-me
ROOT_SECRET_ACCESS_KEY=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
