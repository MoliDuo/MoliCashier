# Docker deployment: copy to .env next to compose.yaml. See docs/self-hosting.md.

# Where the app is served. APP_URL must be https://<CASHIER_HOST>: the OIDC provider redirects back to it.
CASHIER_HOST=cashier.example.com
APP_URL=https://cashier.example.com

# Host directory for the database and object storage (postgres/ and s3/ inside it).
# CASHIER_DATA_DIR=./data
# TZ=Asia/Singapore

# Random values, for example `openssl rand -hex 24`. They only need to stay the same across restarts.
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The one internal secret. Every signing and hashing key is derived from it, so keep it a secure
# random value, identical across restarts and upgrades.
AUTH_SECRET=

# AI provider
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# Sign-in through an OIDC provider (Authelia, for example). Register Cashier there as a client with
# the redirect URI ${APP_URL}/auth/callback; see docs/self-hosting.md "登录（OIDC）".
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=moli-cashier
OIDC_CLIENT_SECRET=

# Advanced
# DATABASE_POOL_MAX=10
# LOG_LEVEL=info
